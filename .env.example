# Copy to .env and fill in. NEVER commit .env.

# Help Scout — Profile → My Apps → Create App
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=

# Agent runtime (the standalone Vercel project's env vars — see PORTAL-SPEC.md)
STRIPE_RESTRICTED_KEY=        # read-only restricted key (rk_...), NOT the secret key
SUPPORT_DB_READONLY_URL=      # PlanetScale mysql:// URL from a READ-ONLY password (dashboard -> Passwords)
INTERNAL_WEBHOOK_SECRET=      # shared secret; filteronme-one sends it as x-internal-secret
AI_GATEWAY_API_KEY=           # local replay only; Vercel deploys use OIDC instead
# AGENT_MODEL=anthropic/claude-sonnet-5   # override the default model
SHOPIFY_STORE_DOMAIN=         # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=          # read-only custom app token
APP_LOOKUP_URL=               # our app's internal read-only endpoint
APP_LOOKUP_TOKEN=
