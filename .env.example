# Copy to .env and fill in. NEVER commit .env.

# Help Scout — Profile → My Apps → Create App
HELPSCOUT_APP_ID=
HELPSCOUT_APP_SECRET=

# Phase 3 (leave empty until then)
STRIPE_RESTRICTED_KEY=        # read-only restricted key, NOT the secret key
SHOPIFY_STORE_DOMAIN=         # yourstore.myshopify.com
SHOPIFY_ADMIN_TOKEN=          # read-only custom app token
APP_LOOKUP_URL=               # our app's internal read-only endpoint
APP_LOOKUP_TOKEN=
